{
  "name": "family-economy",
  "version": "1.0.0",
  "private": true,
  "description": "Private family participation economy: earn, spend, save and convert Family Points.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "billing:run": "tsx scripts/run-maintenance.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "pg": "8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "3.2.7"
  }
}
