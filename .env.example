# PostgreSQL connection string. For hosted databases (Neon, Supabase, Vercel Postgres)
# include ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_economy"

# One-time code required on the /setup page so nobody else can claim your deployment.
# Pick something long and random. You can remove it after setup to disable /setup entirely.
SETUP_TOKEN="change-me-to-something-long-and-random"

# Protects the daily maintenance endpoint (/api/cron/maintenance). Vercel Cron sends it
# automatically as "Authorization: Bearer <CRON_SECRET>" when this variable is set.
CRON_SECRET="change-me-too"

# Emergency recovery for when both parents are locked out (the /recover page).
# Leave unset to disable recovery entirely. At least 12 characters.
RECOVERY_TOKEN="change-me-to-another-long-random-code"

# Optional
# DATABASE_POOL_MAX=5
# DATABASE_SSL=true            # force TLS if your URL doesn't say sslmode=require
